# Writes a C++ source that embeds binary files as byte arrays.
#   cmake -DOUT=<file.cpp> -DNAMESPACE=<ns> -DNAMES=<a|b> -DFILES=<pa|pb> -P EmbedFiles.cmake
# For each NAME: `extern const unsigned char NAME[]` and `extern const std::size_t NAME_size`.
# Used for the UI font (see src/app/ui_font.cpp) so no asset files have to be
# found at runtime on any platform (app bundles, APKs, installers).

string(REPLACE "|" ";" NAMES "${NAMES}")
string(REPLACE "|" ";" FILES "${FILES}")
list(LENGTH NAMES _n)
math(EXPR _last "${_n} - 1")
string(REPEAT "[0-9a-f]" 48 _row) # 24 bytes per line
set(_out "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include <cstddef>\n\nnamespace ${NAMESPACE} {\n")
foreach(_i RANGE ${_last})
  list(GET NAMES ${_i} _name)
  list(GET FILES ${_i} _file)
  file(READ "${_file}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _bytes "${_len} / 2")
  string(REGEX REPLACE "(${_row})" "\\1\n" _hex "${_hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
  string(APPEND _out "extern const unsigned char ${_name}[] = {\n${_hex}\n};\n")
  string(APPEND _out "extern const std::size_t ${_name}_size = ${_bytes};\n\n")
endforeach()
string(APPEND _out "} // namespace ${NAMESPACE}\n")
file(WRITE "${OUT}.tmp" "${_out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
